{
  "name": "@dafan/cloud-worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Minimal Cloudflare Workers scaffold for the Dafan cloud API",
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "build": "esbuild src/index.ts --bundle --format=esm --target=es2022 --external:cloudflare:workers --outfile=dist/index.js"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261120.1",
    "esbuild": "0.28.2"
  }
}
